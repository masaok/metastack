# Copy to .env.local. Never commit real values; .env.local is gitignored.

# Canonical URL used for Open Graph and OAuth redirects. Defaults to https://www.metastack.app
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub App / OAuth App. Used by /api/auth/github.
# Callback URL to register on the GitHub App:
#   http://localhost:3000/api/auth/callback/github
#   https://www.metastack.app/api/auth/callback/github
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Neon Postgres. Either name works. Used to store users and synced progress.
NEON_URL=
# DATABASE_URL=
