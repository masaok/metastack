# Copy to .env.local if you need to override anything. Nothing here is required.

# Canonical URL used for Open Graph metadata. Defaults to https://www.metastack.app
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub App credentials. Nothing in the app reads these yet.
# Never commit real values; .env.local is gitignored.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
