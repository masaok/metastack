# Copy to .env.local in the repo root. Never commit real values; .env.local is gitignored.
# Next only auto-loads env files from apps/web; next.config.ts loads this root file once,
# at startup. After editing .env.local, restart `pnpm dev` so the server sees the change.

# Canonical URL for Open Graph. In production it is also the OAuth origin.
# In development the OAuth callback is the request origin, which must be registered as:
#   http://localhost:3000/api/auth/callback/github
# NEXT_PUBLIC_SITE_URL=https://www.metastack.app

# GitHub App / OAuth App. /api/auth/github sends the browser to GitHub.
# GitHub returns to /api/auth/callback/github. Register both callback URLs on the app:
#   http://localhost:3000/api/auth/callback/github
#   https://www.metastack.app/api/auth/callback/github
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Neon Postgres. Either name works. Stores the cards, users and synced progress.
# With neither set, the app serves the cards that ship in the repository.
# Required for sign-in: the OAuth callback writes the user row before setting the cookie,
# so without it GitHub sign-in ends at /settings?auth=error.
NEON_URL=
# DATABASE_URL=
