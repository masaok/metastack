{
  "name": "metastack-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source flashcards for system design interviews. FSRS scheduling, Markdown cards, no account.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @metastack/web dev",
    "build": "pnpm --filter @metastack/web build",
    "start": "pnpm --filter @metastack/web start",
    "compile": "pnpm --filter @metastack/content compile",
    "validate": "pnpm --filter @metastack/content validate",
    "typecheck": "pnpm compile && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "test": "pnpm compile && pnpm -r --if-present test",
    "test:coverage": "pnpm compile && pnpm -r --if-present test:coverage",
    "e2e": "pnpm --filter @metastack/web e2e",
    "check:public": "bash scripts/check-public.sh",
    "check:public:test": "bash scripts/check-public.test.sh",
    "check:docs": "node scripts/check-docs-links.mjs",
    "check:docs:test": "node scripts/check-docs-links.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm typecheck && pnpm build"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "^22"
  }
}
