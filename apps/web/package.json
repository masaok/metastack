{
  "name": "@metastack/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @metastack/content compile && next dev",
    "build": "pnpm --filter @metastack/content compile && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm --filter @metastack/content compile && tsc --noEmit",
    "e2e": "playwright test",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "@metastack/content": "workspace:*",
    "@metastack/srs": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "lucide-react": "^0.545.0",
    "mermaid": "^11.12.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.18.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
