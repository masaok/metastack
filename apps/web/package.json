{
  "name": "@metastack/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @metastack/content compile && next dev",
    "build": "pnpm --filter @metastack/content compile && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "pnpm --filter @metastack/content compile && tsc --noEmit",
    "e2e": "playwright test",
    "lint:fix": "eslint --fix",
    "db:seed": "pnpm --filter @metastack/content compile && tsx --env-file-if-exists=../../.env.local scripts/seed-cards.ts",
    "check:blog": "tsx scripts/check-blog.ts ../..",
    "check:blog:test": "tsx scripts/check-blog.test.ts",
    "test": "tsx src/lib/progress/merge.test.ts && tsx src/lib/dashboard/rows.test.ts && tsx src/lib/dashboard/progress.test.ts && tsx src/lib/auth/admin.test.ts && tsx src/lib/settings.test.ts && tsx src/lib/cards/store.test.ts && tsx src/lib/cards/draft.test.ts && tsx src/lib/study/exercise.test.ts"
  },
  "dependencies": {
    "@metastack/content": "workspace:*",
    "@metastack/srs": "workspace:*",
    "@neondatabase/serverless": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.50.0",
    "mermaid": "^12.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.18.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
