{
  "name": "@metastack/content",
  "version": "0.1.0",
  "private": true,
  "description": "The MetaStack question bank: Markdown cards validated by Zod and compiled to JSON at build time.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "compile": "tsx scripts/compile.ts",
    "validate": "tsx scripts/validate.ts",
    "typecheck": "tsx scripts/compile.ts && tsc -p tsconfig.json",
    "lint": "eslint src scripts",
    "test": "tsx scripts/compile.ts && vitest run",
    "test:coverage": "tsx scripts/compile.ts && vitest run --coverage",
    "lint:fix": "eslint --fix src scripts"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.37.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
